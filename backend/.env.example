# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embedding model used for the few-shot example selector (ChromaDB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local storage (relative to backend/)
SQLITE_PATH=data/store_inventory.db
CHROMA_PERSIST_DIR=data/chroma

SQL_CHAIN_VERBOSE=true
FEW_SHOT_EXAMPLES_K=3

# JSON array of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]

# Optional: forward LLM calls to LangSmith for hosted tracing in addition to the
# built-in /api/traces endpoint. Leave unset to use only the built-in tracer.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=intelligent-query-engine
